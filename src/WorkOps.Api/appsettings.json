{
  "AllowedHosts": "localhost;127.0.0.1",
  "Authentication": {
    "Audience": "workops-api",
    "Issuer": "https://identity.example.invalid/realms/workops",
    "RequireHttpsMetadata": true,
    "AllowedAlgorithms": [
      "RS256"
    ]
  },
  "ConnectionStrings": {
    "WorkOps": "Host=localhost;Port=5432;Database=workops;Username=workops;Include Error Detail=false"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Messaging": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "workops"
  },
  "Operations": {
    "ApplyMigrations": false
  }
}
