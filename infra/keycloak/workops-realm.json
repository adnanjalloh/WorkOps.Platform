{
  "realm": "workops",
  "enabled": true,
  "displayName": "WorkOps local development",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "workops-api",
      "name": "WorkOps API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "workops-cli",
      "name": "WorkOps local CLI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "workops-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "workops-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "demo-owner",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Owner",
      "email": "owner@workops.local",
      "credentials": [
        {
          "type": "password",
          "value": "local-demo-only",
          "temporary": false
        }
      ]
    },
    {
      "username": "demo-contributor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Contributor",
      "email": "contributor@workops.local",
      "credentials": [
        {
          "type": "password",
          "value": "local-demo-only",
          "temporary": false
        }
      ]
    },
    {
      "username": "demo-viewer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Viewer",
      "email": "viewer@workops.local",
      "credentials": [
        {
          "type": "password",
          "value": "local-demo-only",
          "temporary": false
        }
      ]
    },
    {
      "username": "demo-outsider",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Outsider",
      "email": "outsider@workops.local",
      "credentials": [
        {
          "type": "password",
          "value": "local-demo-only",
          "temporary": false
        }
      ]
    }
  ]
}
